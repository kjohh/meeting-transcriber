<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Ad-hoc dev builds ONLY. An ad-hoc signature carries no Team ID, and
	     hardened runtime refuses to load a library whose Team ID differs from
	     the process's ("mapping process and mapped file have different Team
	     IDs"), so Python.framework can't load. A Developer ID build signs
	     every binary with the same team and uses entitlements.plist instead. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
